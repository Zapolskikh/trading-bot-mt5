**Задачи:**
- [ ] Создать `src/common/state_manager.py`:
  ```python
  import json
  from datetime import datetime, timedelta
  from pathlib import Path

  class StateManager:
      def __init__(self, state_dir: Path = Path("data/state")):
          self.state_dir = state_dir
          self.state_dir.mkdir(parents=True, exist_ok=True)

      def save_state(self, strategy_name: str, state: dict) -> None:
          """Сохранить состояние стратегии"""
          state['timestamp'] = datetime.now().isoformat()
          file_path = self.state_dir / f"{strategy_name}.json"
          with open(file_path, 'w') as f:
              json.dump(state, f, indent=2)

      def load_state(self, strategy_name: str, max_age_minutes: int = 30) -> dict:
          """Загрузить состояние (если не устарело)"""
          file_path = self.state_dir / f"{strategy_name}.json"
          if not file_path.exists():
              return None

          with open(file_path, 'r') as f:
              state = json.load(f)

          timestamp = datetime.fromisoformat(state['timestamp'])
          age = datetime.now() - timestamp

          if age > timedelta(minutes=max_age_minutes):
              logger.warning(f"State for {strategy_name} expired ({age.total_seconds():.0f}s old)")
              return None

          return state
  ```

- [ ] Интегрировать с Strategy:
